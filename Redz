--// CONFIG
local Configs_HUB = {
  Cor_Hub = Color3.fromRGB(10,10,15),
  Cor_Options = Color3.fromRGB(20,20,30),
  Cor_Stroke = Color3.fromRGB(0,170,255),
  Cor_Text = Color3.fromRGB(255,255,255),
  Cor_DarkText = Color3.fromRGB(170,170,170),
  Corner_Radius = UDim.new(0,8),
  Text_Font = Enum.Font.GothamBold
}

--// SERVICES
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

--// CREATE
local function Create(i,p,pr)
  local o = Instance.new(i,p)
  if pr then for k,v in pairs(pr) do o[k]=v end end
  return o
end

--// UI EFFECT
local function Corner(p)
  return Create("UICorner",p,{CornerRadius=Configs_HUB.Corner_Radius})
end

local function Stroke(p)
  return Create("UIStroke",p,{
    Color=Configs_HUB.Cor_Stroke,
    Thickness=1.5
  })
end

local function Glow(p)
  return Create("UIStroke",p,{
    Color=Configs_HUB.Cor_Stroke,
    Thickness=3,
    Transparency=0.4
  })
end

local function Tween(obj,prop,val,t)
  local tw = TweenService:Create(obj,TweenInfo.new(t,Enum.EasingStyle.Quad),{[prop]=val})
  tw:Play()
end

local function Hover(btn)
  btn.MouseEnter:Connect(function()
    Tween(btn,"TextColor3",Configs_HUB.Cor_Stroke,0.2)
  end)
  btn.MouseLeave:Connect(function()
    Tween(btn,"TextColor3",Configs_HUB.Cor_Text,0.2)
  end)
end

--// GUI
local ScreenGui = Create("ScreenGui",CoreGui,{Name="NeonHub"})

--// NOTIFICATION
local function Notify(title,text)
