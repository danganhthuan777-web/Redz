    BackgroundColor3 = Configs_HUB.Cor_Hub,
    BackgroundTransparency = 0.15, -- Xám trong suốt
    Active = true,
    Draggable = true,
    Visible = false -- Sẽ hiện sau animation
  })Corner(Menu)Stroke(Menu)
  
  local TopBar = Create("Frame", Menu, {
    Size = UDim2.new(1, 0, 0, 30),
    BackgroundTransparency = 1
  })
  
  local TitleLabel = Create("TextLabel", TopBar, {
    Size = UDim2.new(1, -80, 1, 0),
    Position = UDim2.new(0, 15, 0, 0),
    Text = title,
    Font = Configs_HUB.Text_Font,
    TextColor3 = Configs_HUB.Cor_Text,
    TextSize = 18,
    TextXAlignment = "Left",
    BackgroundTransparency = 1
  })

  -- Nút đóng và thu nhỏ
  local Btns = Create("Frame", TopBar, {
    Size = UDim2.new(0, 70, 1, 0),
    Position = UDim2.new(1, -5, 0, 0),
    AnchorPoint = Vector2.new(1, 0),
    BackgroundTransparency = 1
  })
  
  local CloseBtn = Create("TextButton", Btns, {
    Size = UDim2.new(0.5, 0, 1, 0),
    Position = UDim2.new(0.5, 0, 0, 0),
    Text = "×",
    Font = Configs_HUB.Text_Font,
    TextSize = 25,
    TextColor3 = Color3.fromRGB(255, 50, 50),
    BackgroundTransparency = 1
  })

  CloseBtn.MouseButton1Click:Connect(function()
    DestroyScript()
  end)

  -- Animation khởi tạo
  local AnimMenu = Create("Frame", ScreenGui, {
    Size = UDim2.new(0, 0, 0, 35),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundColor3 = Configs_HUB.Cor_Hub,
    BackgroundTransparency = 0.1
  })Corner(AnimMenu)Stroke(AnimMenu)

  CreateTween(AnimMenu, "Size", UDim2.new(0, 200, 0, 35), 0.5, true)
  task.wait(0.5)
  AnimMenu:Destroy()
  Menu.Visible = true

  -- Cấu trúc Tab
  local ScrollTab = Create("ScrollingFrame", Menu, {
    Size = UDim2.new(0, 130, 1, -35),
    Position = UDim2.new(0, 5, 0, 32),
    BackgroundTransparency = 1,
    ScrollBarThickness = 2,
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = "Y"
  })Create("UIListLayout", ScrollTab, {Padding = UDim.new(0, 5)})
  
  local ContainerHold = Create("Frame", Menu, {
    Size = UDim2.new(1, -145, 1, -35),
    Position = UDim2.new(0, 140, 0, 32),
    BackgroundTransparency = 1
  })

  -- Đường kẻ ngăn cách (Màu Vàng)
  Create("Frame", Menu, {
    Size = UDim2.new(1, 0, 0, 1),
    Position = UDim2.new(0, 0, 0, 30),
    BackgroundColor3 = Configs_HUB.Cor_Stroke,
    BorderSizePixel = 0
  })

  function MakeTab(TabConfigs)
    local TabName = TabConfigs.Name or "Tab"
    
    local TabBtn = Create("TextButton", ScrollTab, {
      Size = UDim2.new(1, -10, 0, 30),
      BackgroundColor3 = Configs_HUB.Cor_Options,
      Text = TabName,
      Font = Configs_HUB.Text_Font,
      TextColor3 = Configs_HUB.Cor_DarkText,
      TextSize = 14
    })Corner(TabBtn)Stroke(TabBtn)

    local TabPage = Create("ScrollingFrame", ContainerHold, {
      Size = UDim2.new(1, 0, 1, 0),
      BackgroundTransparency = 1,
      Visible = false,
      ScrollBarThickness = 2,
      CanvasSize = UDim2.new(0, 0, 0, 0),
      AutomaticCanvasSize = "Y"
    })Create("UIListLayout", TabPage, {Padding = UDim.new(0, 5)})

    TabBtn.MouseButton1Click:Connect(function()
      for _, v in pairs(ContainerHold:GetChildren()) do v.Visible = false end
      TabPage.Visible = true
    end)
    
    -- Mặc định hiện tab đầu tiên
    if #ScrollTab:GetChildren() == 2 then -- 2 vì có UIListLayout
        TabPage.Visible = true
    end

    return TabPage
  end
end

