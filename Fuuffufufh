function MakeNotifi(Configs)
  local TitleText = Configs.Title or "REDz HUB"
  local text = Configs.Text or "Notification"
  local timewait = Configs.Time or 5
  
  local Frame1 = Create("Frame", Menu_Notifi, {
    Size = UDim2.new(1, 0, 0, 0),
    BackgroundTransparency = 1,
    AutomaticSize = "Y"
  })
  
  local Frame2 = Create("Frame", Frame1, {
    Size = UDim2.new(0, 250, 0, 0),
    BackgroundColor3 = Configs_HUB.Cor_Hub,
    BackgroundTransparency = 0.2, -- Xám trong suốt
    Position = UDim2.new(1, 300, 0, 0),
    AutomaticSize = "Y"
  })Corner(Frame2)Stroke(Frame2)
  
  Create("TextLabel", Frame2, {
    Size = UDim2.new(1, -40, 0, 25),
    Position = UDim2.new(0, 15, 0, 5),
    Text = TitleText,
    Font = Configs_HUB.Text_Font,
    TextColor3 = Configs_HUB.Cor_Stroke, -- Tiêu đề màu vàng cho đẹp
    TextSize = 18,
    TextXAlignment = "Left",
    BackgroundTransparency = 1
  })

  local Desc = Create("TextLabel", Frame2, {
    Size = UDim2.new(1, -30, 0, 0),
    Position = UDim2.new(0, 15, 0, 35),
    Text = text,
    Font = Configs_HUB.Text_Font,
    TextColor3 = Configs_HUB.Cor_Text,
    TextSize = 14,
    TextWrapped = true,
    AutomaticSize = "Y",
    TextXAlignment = "Left",
    BackgroundTransparency = 1
  })

  task.spawn(function()
    CreateTween(Frame2, "Position", UDim2.new(1, -260, 0, 0), 0.5)
    task.wait(timewait)
    CreateTween(Frame2, "Position", UDim2.new(1, 300, 0, 0), 0.5)
    task.wait(0.5)
    Frame1:Destroy()
  end)
end

-- Cửa sổ chính (Main Window)
function MakeWindow(Configs)
